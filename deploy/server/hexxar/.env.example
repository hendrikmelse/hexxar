# Copy to /srv/hexxar/.env on the server (chmod 600). Read by compose when the container starts, so
# after changing it run: docker compose -f /srv/hexxar/compose.yaml up -d (with IMAGE set, e.g. from
# current-image), or simply redeploy.
#
# PORT and STATIC_DIR are set by the Docker image: do not set them here.

# Beta access code: visitors must enter it before they can play. Leave empty to let anyone in.
BETA_CODE=change-me

# ---- Feedback and bug reports ------------------------------------------------------------------
# The feedback page's messages are emailed through Resend (https://resend.com). Leave
# RESEND_API_KEY or FEEDBACK_TO empty to turn it off: the page then says it is not set up.

# Your Resend API key (starts with re_).
RESEND_API_KEY=

# Where the emails go. With the default sender below, this must be the address your Resend
# account is registered with.
FEEDBACK_TO=

# The sender shown on them: an address on a domain you have verified in Resend. The default only
# works for testing, and only to your own account's address.
FEEDBACK_FROM=Hexxar <onboarding@resend.dev>

# Resend's address for sending email. Only for trying the feedback page against a stand-in server.
# RESEND_API_URL=https://api.resend.com/emails

# ---- Timing (all in milliseconds). Everything here is optional: the value shown is the default, so
# ---- the lines can stay commented out unless you want something different.

# From a match being created to its first tick: the client's 1.5 second loading screen plus
# 5 seconds of planning.
# PREP_MS=6500

# Public Battle Royale: how long it waits for more players once it has 3, and the least a
# newcomer's arrival tops that wait up to.
# EARLY_START_MS=60000
# JOIN_WAIT_MS=10000

# How long a public room waits, once it is full, before the match starts; and how long after a
# vote to start early.
# FULL_WAIT_MS=5000
# VOTE_START_MS=5000

# How often the title screen's "online" counts are refreshed (0 turns the updates off).
# STATS_MS=2000

# How long a disconnected player has before their army surrenders.
# AFK_MS=120000

# How long a finished game's room stays open for people to look at the result.
# FINISHED_LINGER_MS=600000
