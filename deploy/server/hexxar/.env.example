# Copy to /srv/hexxar/.env on the server. Read by compose when the container starts, so after
# changing it run: docker compose -f /srv/hexxar/compose.yaml up -d (with IMAGE set, e.g. from
# current-image), or simply redeploy.

# Beta access code: visitors must enter it before they can play. Leave empty to let anyone in.
BETA_CODE=change-me
