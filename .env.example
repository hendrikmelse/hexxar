# Copy to .env (never commit it). Read by `pnpm dev` and `pnpm --filter @hexxar/server start`.

# ---- The server ---------------------------------------------------------------------------------

# Port the game server listens on (the page, the health check, the feedback form and the WebSocket).
PORT=8080

# A folder with the built client to serve as the page, so one process serves everything. Leave unset
# in development, where `pnpm dev` runs the client separately; the Docker image sets it itself.
# STATIC_DIR=

# ---- Database --------------------------------------------------------------------------------
# Feedback and analytics are kept in Postgres. `docker compose up -d db` starts one for development
# (see docker-compose.yml); the server creates its tables when it starts. Without this, feedback is
# kept in memory (lost on restart) and analytics is off. In production it is set on the server.
DATABASE_URL=postgres://hexxar:hexxar@localhost:5433/hexxar

# ---- Admin panel and feedback --------------------------------------------------------------------
# /?admin opens the admin panel (live numbers and the feedback hub) once this password is entered.
# Leave it empty to turn the panel off. Use a long one: it is the only thing protecting it.
ADMIN_PASSWORD=

# Feedback is kept in the hub, and every day at DIGEST_HOUR one email lists what is still
# unresolved (none is sent when everything is). It goes out through Resend (https://resend.com).
# Leave RESEND_API_KEY or FEEDBACK_TO empty to turn the email off.

# Your Resend API key (starts with re_).
RESEND_API_KEY=

# Where the email goes. With the default sender below, this must be the address your Resend
# account is registered with.
FEEDBACK_TO=

# The sender shown on it: an address on a domain you have verified in Resend. The default only
# works for testing, and only to your own account's address.
FEEDBACK_FROM=Hexxar <onboarding@resend.dev>

# The hour of the day (0-23) the email goes out, and the time zone it is read in.
# DIGEST_HOUR=7
# DIGEST_TIMEZONE=America/Los_Angeles

# The site's address, for the link to the admin panel in the email.
# PUBLIC_URL=https://hexxar.io

# Resend's address for sending email. Only for trying it out against a stand-in server.
# RESEND_API_URL=https://api.resend.com/emails

# ---- Timing (all in milliseconds). Everything here is optional: the value shown is the default, so
# ---- the lines can stay commented out unless you want something different.

# From a match being created to its first tick: the client's 1.5 second loading screen plus
# 5 seconds of planning.
# PREP_MS=6500

# Public Battle Royale: how long it waits for more players once it has 3, and the least a
# newcomer's arrival tops that wait up to.
# EARLY_START_MS=60000
# JOIN_WAIT_MS=10000

# How long a public room waits, once it is full, before the match starts; and how long after a
# vote to start early.
# FULL_WAIT_MS=5000
# VOTE_START_MS=5000

# How often the title screen's "online" counts are refreshed (0 turns the updates off).
# STATS_MS=2000

# How long a disconnected player has before their army surrenders.
# AFK_MS=120000

# How long a finished game's room stays open for people to look at the result.
# FINISHED_LINGER_MS=600000

# ---- The client (not read from this file) --------------------------------------------------------
# VITE_SERVER_URL points the client at a game server somewhere else (a WebSocket address such as
# ws://localhost:8099/ws). Vite reads it from the shell or from apps/client/.env, not from here.
